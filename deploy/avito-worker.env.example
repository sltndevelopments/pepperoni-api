# Save this as /etc/pepperoni-avito-worker.env on production.
# Do not commit real credentials.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_POLL_INTERVAL=10
AVITO_HTTP_RETRIES=3
# Consecutive failed ticks before one Telegram down-alert (recovery is also one message).
AVITO_ALERT_FAILS=3
AVITO_CHATS_PAGE_SIZE=100
AVITO_CHATS_MAX_PAGES=5
AVITO_RECRUITMENT_URL_MARKERS=vakansii
AVITO_WORKER_DB=/var/www/pepperoni/data/avito-worker.sqlite3
AVITO_CATALOG_URL=https://api.pepperoni.tatar/api/products
AVITO_CATALOG_CACHE_SECONDS=600

# Preferred provider for Avito replies: OpenAI GPT-4.1 mini.
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# Only if the proxy actually allows CONNECT to api.openai.com.
# If SOCKS5 refuses OpenAI, leave this unset — the worker falls back to
# direct, then DeepSeek, and cools down instead of flooding syslog.
# LLM_SOCKS5_PROXY=socks5h://user:password@host:port
# LLM_SOCKS5_PROXIES=socks5h://user:pass@host1:port,socks5h://user:pass@host2:port
# LLM_COOLDOWN_SECONDS=120
#
# Advanced override for any OpenAI-compatible provider:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
#
# The worker falls back to existing DEEPSEEK_* variables only while OpenAI is unset.
# Set LLM_PROVIDER=deepseek to keep the fallback active while an OpenAI proxy
# or supported-region backend is being configured.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# Existing Pepperoni lead pipeline settings:
LEADS_BOT_TOKEN=
LEADS_GROUP_ID=
