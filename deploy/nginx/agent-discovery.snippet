# server-context. Homepage is location = / in pepperoni-static-data.conf
# (own add_header + security-headers). Link lives in security-headers, not here.
# Do not redefine /llms.txt — it already exists in static-data.

if ($pepperoni_wants_markdown) {
    rewrite ^/$ /llms.txt last;
    rewrite ^/en/?$ /en/llms.txt last;
}

location = /.well-known/api-catalog {
    root /var/www/pepperoni/repo/public;
    default_type "application/linkset+json";
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=300" always;
    try_files $uri =404;
}

location = /.well-known/oauth-protected-resource {
    root /var/www/pepperoni/repo/public;
    default_type "application/json; charset=utf-8";
    add_header Access-Control-Allow-Origin "*" always;
    try_files $uri =404;
}

location = /.well-known/oauth-authorization-server {
    root /var/www/pepperoni/repo/public;
    default_type "application/json; charset=utf-8";
    add_header Access-Control-Allow-Origin "*" always;
    try_files $uri =404;
}

location = /.well-known/openid-configuration {
    root /var/www/pepperoni/repo/public;
    default_type "application/json; charset=utf-8";
    add_header Access-Control-Allow-Origin "*" always;
    try_files $uri =404;
}

location = /.well-known/http-message-signatures-directory {
    root /var/www/pepperoni/repo/public;
    default_type "application/http-message-signatures-directory+json";
    add_header Access-Control-Allow-Origin "*" always;
    try_files $uri =404;
}

location = /auth.md {
    root /var/www/pepperoni/repo/public;
    default_type "text/markdown; charset=utf-8";
    add_header Access-Control-Allow-Origin "*" always;
    try_files $uri =404;
}

location = /.well-known/ai-catalog.json {
    root /var/www/pepperoni/repo/public;
    default_type "application/json";
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=300" always;
    try_files $uri =404;
}

location = /.well-known/ard.json {
    root /var/www/pepperoni/repo/public;
    default_type "application/json";
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=300" always;
    try_files $uri =404;
}
