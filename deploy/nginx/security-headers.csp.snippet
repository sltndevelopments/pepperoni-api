# CSP for pepperoni.tatar HTML pages.
# Applied by deploy-vps.yml → scripts/apply_nginx_csp.sh (sed-replace of the
# existing Content-Security-Policy add_header line). Keep in sync with the
# staging CSP in vercel.json.
#
# YouTube is required for /pepperoni video facades (youtube-nocookie iframe +
# iframe_api). Without frame-src/youtube* Brave/Chrome show
# «Этот контент заблокирован» and Safari leaves a black box.
#
# Google Ads conversion beacons need googleadservices / googleads.g.doubleclick
# in script-src + connect-src. Without them the AW tag loads but conversion
# hits are blocked by the browser → Ads stays at 0 forever.
#
# Tag Assistant / GTM Preview need tagassistant.google.com + tagmanager.google.com
# in frame-src/connect-src/script-src — otherwise «время ожидания истекло».

add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://googletagmanager.com https://tagmanager.google.com https://tagassistant.google.com https://www.googleadservices.com https://www.google.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://analytics.ahrefs.com https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.googletagmanager.com https://tagmanager.google.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.pepperoni.tatar https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://tagmanager.google.com https://tagassistant.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://google.com https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com https://yandex.ru https://formspree.io https://analytics.ahrefs.com https://www.youtube.com https://www.youtube-nocookie.com; form-action 'self' https://api.pepperoni.tatar; frame-src https://www.googletagmanager.com https://tagassistant.google.com https://tagmanager.google.com https://www.youtube-nocookie.com https://www.youtube.com;" always;
