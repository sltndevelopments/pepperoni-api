# CSP for pepperoni.tatar HTML pages.
# Applied by deploy-vps.yml → scripts/apply_nginx_csp.sh (sed-replace of the
# existing Content-Security-Policy add_header line). Keep in sync with the
# staging CSP in vercel.json.
#
# YouTube is required for /pepperoni video facades (youtube-nocookie iframe +
# iframe_api). Without frame-src/youtube* Brave/Chrome show
# «Этот контент заблокирован» and Safari leaves a black box.

add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://googletagmanager.com https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://analytics.ahrefs.com https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://api.pepperoni.tatar https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com https://yandex.ru https://formspree.io https://analytics.ahrefs.com https://www.youtube.com https://www.youtube-nocookie.com; form-action 'self' https://api.pepperoni.tatar; frame-src https://www.googletagmanager.com https://www.youtube-nocookie.com https://www.youtube.com;" always;
