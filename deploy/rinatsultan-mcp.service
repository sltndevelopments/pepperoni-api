[Unit]
Description=rinatsultan.com MCP server (Streamable HTTP + SSE)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/pepperoni/repo
Environment=MCP_PORT=8131
EnvironmentFile=-/var/www/pepperoni/repo/deploy/rinatsultan-mcp.env
ExecStart=/usr/bin/node rinatsultan-mcp/http-server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
