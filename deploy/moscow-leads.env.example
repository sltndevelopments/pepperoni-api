# Скопировать в /var/www/pepperoni/moscow-leads.env на VPS
MOSCOW_LEAD_BOT_TOKEN=
# Рабочая группа — только пятничный дайджест, не карточки
MOSCOW_LEAD_GROUP_CHAT_ID=
MOSCOW_LEAD_OWNER_CHAT_ID=
# Лички менеджеров (статический fallback; /start больше не перезаписывает Арби)
MOSCOW_LEAD_ARBI_CHAT_ID=
MOSCOW_LEAD_ZAUR_CHAT_ID=
# Белый список telegram user_id. Пусто = все (только dev). В проде обязательно.
MOSCOW_LEAD_ALLOWED_USER_IDS=
# MOSCOW_LEADS_DISABLED=0
